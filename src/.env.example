# Environment variables example file
# Copy this file as .env.local in /src/ and configure the correct values
#
# ─── BUILD-TIME (NEXT_PUBLIC_*) ───────────────────────────────────
# These are injected into the Next.js bundle during docker build.
# Requires rebuild per environment (different subpath or API).
# Pass as --build-arg in docker build.

# Keycloak
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
# Keycloak realm
NEXT_PUBLIC_KEYCLOAK_REALM=realm_name
# Keycloak client ID
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=client_id

# Climate API URL
NEXT_PUBLIC_ACLIMATE_API_URL=http://127.0.0.1:8000
# Auth API URL
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3001/api
# Frontend preferences API base URL
NEXT_PUBLIC_ACLIMATE_API_FRONTEND_URL=http://127.0.0.1:9000
NEXT_PUBLIC_ACLIMATE_APP_ID=1
NEXT_PUBLIC_COUNTRY_NAME='CountryName'
NEXT_PUBLIC_GEOSERVER_URL=https://geoserver.com
NEXT_PUBLIC_SHOW_STATIONS_MODULE=true
NEXT_PUBLIC_SHOW_USERS_MODULE=true

# Forecast API (leave empty to hide the forecast section)
NEXT_PUBLIC_FORECAST_API_URL=https://example.com/

# Base path for subpath deployment (e.g., /ahuachapansur)
# If deploying at the domain root, leave empty or unset.
# ⚠️ Changing this value between environments requires a rebuild.
# --- NOTE for Docker ---
# When using the Docker image, the container always serves on "/".
# Subpath routing is handled externally (reverse proxy / ingress).
# Do NOT pass NEXT_PUBLIC_BASE_PATH as --build-arg unless you know
# what you are doing — it will break asset loading in production.
NEXT_PUBLIC_BASE_PATH=/ahuachapansur

# ─── RUNTIME (server-side only) ───────────────────────────────────
# These are passed to the container via docker run -e (no rebuild needed).
# Never exposed to the browser or included in the bundle.

# Keycloak client secret for server-side token exchange
KEYCLOAK_CLIENT_SECRET=secret_client